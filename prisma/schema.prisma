// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  password         String?
  image            String?
  plan             String   @default("free") // free | pro | annual
  role             String   @default("candidate") // candidate | employer
  companyName      String?
  industry         String?
  companyWebsite   String?
  cvCountThisMonth Int      @default(0)
  clCountThisMonth Int      @default(0)
  lastResetMonth   Int      @default(0)
  lsCustomerId     String?
  lsVariantId      String?
  lsSubId          String?
  paymobOrderId    String?
  paymobPaymentId  String?
  paymobProvider   String?
  resetCode        String?
  resetCodeExpires DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  referralCode       String?  @unique
  referralsMade      Referral[]  @relation("ReferrerReferrals")
  referralReceived   Referral?  @relation("ReferredReferral")

  resumes      Resume[]
  coverLetters CoverLetter[]
  satisfactionRatings SatisfactionRating[]
  supportTickets      SupportTicket[]
  jobListings         JobListing[]
  applications        Application[]
  globalJobListings   GlobalJobListing[]  @relation("GlobalEmployer")
  globalApplications  GlobalApplication[]
  mobilityProfiles    MobilityProfile[]
}

model SatisfactionRating {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // cv | cover_letter
  itemId    String?
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("open") // open | resolved | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Resume {
  id               String   @id @default(cuid())
  userId           String?
  fullName         String
  email            String
  phone            String?
  location         String?
  linkedin         String?
  website          String?
  targetJob        String
  industry         String?
  language         String   @default("fr")
  experience       String?
  education        String?
  skills           String?
  languages        String?
  summary          String?
  softSkills       String?
  dateOfBirth      String?
  birthPlace       String?
  birthCountry     String?
  templateStyle    String   @default("modern")
  generatedContent String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SecurityLog {
  id        String   @id @default(cuid())
  type      String   // rate_limit | brute_force | suspicious_input | sql_injection_attempt | xss_attempt | invalid_auth | forbidden_access
  severity  String   // low | medium | high | critical
  ip        String
  path      String
  method    String
  userAgent String?
  email     String?
  details   String?
  createdAt DateTime @default(now())
}

model CoverLetter {
  id               String   @id @default(cuid())
  userId           String?
  fullName         String
  email            String
  phone            String?
  location         String?
  companyName      String
  hiringManager    String?
  jobTitle         String
  jobReference     String?
  whyCompany       String?
  keyStrengths     String?
  tone             String   @default("semi-formal")
  additionalNotes  String?
  language         String   @default("fr")
  generatedContent String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model JobListing {
  id               String   @id @default(cuid())
  employerId       String?
  title            String
  company          String
  location         String
  country          String   @default("Maroc")
  type             String   @default("CDI")
  salaryMin        Int?
  salaryMax        Int?
  currency         String   @default("MAD")
  description      String
  requirements      String
  skills           String?
  language         String   @default("fr")
  isRemote         Boolean  @default(false)
  isPaid           Boolean  @default(false)
  status           String   @default("active")
  viewsCount       Int      @default(0)
  applicationsCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employer         User?       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications     Application[]
}

model Application {
  id            String   @id @default(cuid())
  jobId         String
  candidateId   String?
  candidateName String
  candidateEmail String
  coverNote     String?
  matchScore    Int?
  matchAnalysis String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  job           JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     User?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
}

model ApiSubscriber {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  company         String
  website         String?
  industry        String?
  phone           String?
  apiKey          String   @unique
  apiSecretHash   String
  plan            String   @default("starter")
  status          String   @default("active")
  creditsUsed     Int      @default(0)
  creditsLimit    Int      @default(100)
  lastResetDate   String   @default("")
  webhookUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  usageLogs       ApiUsageLog[]
}

model ApiUsageLog {
  id            String   @id @default(cuid())
  subscriberId  String
  endpoint      String
  credits       Int      @default(1)
  status        String   @default("success")
  errorMessage  String?
  ip            String?
  createdAt     DateTime @default(now())
  subscriber    ApiSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
}

// ===== HireNova Global — International Recruitment =====

model GlobalJobListing {
  id               String   @id @default(cuid())
  employerId       String?
  title            String
  company          String
  location         String
  country          String
  region           String   // Europe, Asia, Africa, Americas, MENA
  type             String   @default("CDI")
  salaryMin        Int?
  salaryMax        Int?
  currency         String   @default("EUR")
  description      String
  requirements      String
  skills           String?
  language         String   @default("en")
  visaSponsorship  Boolean  @default(false)
  relocationPackage Boolean  @default(false)
  isRemote         Boolean  @default(false)
  status           String   @default("active")
  viewsCount       Int      @default(0)
  applicationsCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employer         User?       @relation("GlobalEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  applications     GlobalApplication[]
}

model GlobalApplication {
  id            String   @id @default(cuid())
  jobId         String
  candidateId   String?
  candidateName String
  candidateEmail String
  coverNote     String?
  matchScore    Int?
  matchAnalysis String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  job           GlobalJobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     User?           @relation(fields: [candidateId], references: [id], onDelete: SetNull)
}

// ===== HireNova Mobilité — Country-specific CV/CL formatting =====

model MobilityProfile {
  id              String   @id @default(cuid())
  userId          String?
  fullName        String
  email           String
  originCountry   String
  targetCountry   String
  targetRole      String
  extractedText   String   // OCR raw text
  structuredData  String   // JSON: parsed profile
  skills          String   // JSON: normalized skills array
  matchScore      Int?
  formattedCV     String?  // country-specific CV content
  formattedCL     String?  // country-specific CL content
  status          String   @default("draft") // draft | processing | completed | error
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ===== HireNova Referral — Programme Parrainage =====

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referralCode   String
  referredEmail  String
  referredUserId String? @unique
  status         String   @default("PENDING") // PENDING | COMPLETED | REWARDED
  rewardType     String   @default("FREE_MONTH") // FREE_MONTH | DISCOUNT
  rewardValue    String   @default("1")
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  referrer User @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User? @relation("ReferredReferral", fields: [referredUserId], references: [id])

  @@unique([referrerId, referredEmail])
}
