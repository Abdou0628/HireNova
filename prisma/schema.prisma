// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  password         String?
  image            String?
  plan             String   @default("free") // free | pro | lifetime
  cvCountThisMonth Int      @default(0)
  clCountThisMonth Int      @default(0)
  lastResetMonth   Int      @default(0)
  stripeCustomerId String?
  stripePriceId    String?
  stripeSubId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  resumes      Resume[]
  coverLetters CoverLetter[]
}

model Resume {
  id               String   @id @default(cuid())
  userId           String?
  fullName         String
  email            String
  phone            String?
  location         String?
  linkedin         String?
  website          String?
  targetJob        String
  industry         String?
  language         String   @default("fr")
  experience       String?
  education        String?
  skills           String?
  languages        String?
  summary          String?
  softSkills       String?
  dateOfBirth      String?
  birthPlace       String?
  birthCountry     String?
  templateStyle    String   @default("modern")
  generatedContent String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CoverLetter {
  id               String   @id @default(cuid())
  userId           String?
  fullName         String
  email            String
  phone            String?
  location         String?
  companyName      String
  hiringManager    String?
  jobTitle         String
  jobReference     String?
  whyCompany       String?
  keyStrengths     String?
  tone             String   @default("semi-formal")
  additionalNotes  String?
  language         String   @default("fr")
  generatedContent String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
